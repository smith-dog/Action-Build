diff --git a/drivers/bluetooth/btmtk_stp_hci.c b/drivers/bluetooth/btmtk_stp_hci.c
new file mode 100644
index 00000000..a2368730
--- /dev/null
+++ b/drivers/bluetooth/btmtk_stp_hci.c
@@ -0,0 +1,468 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * btmtk_stp_hci.c - Thin HCI glue for MediaTek STP-based Bluetooth (MT6895 consys)
+ *
+ * Binds the MTK combo connsys core (wmt_drv.ko: WMT power control + STP
+ * protocol engine, the very engine that stands behind /dev/stpbt) to the
+ * standard Linux Bluetooth stack, so the phone's built-in controller shows
+ * up as /sys/class/bluetooth/hci0 without USB or UART.
+ *
+ * Architecture (all symbols are EXPORT_SYMBOL'd by wmt_drv.ko):
+ *
+ *      firmware (MT6895 consys BT)
+ *        |  STP frames over internal connsys interface
+ *      wmt_drv.ko  stp_core.c  (mtk_wcn_stp_* API, f_bluez mode)
+ *        |  hci0 glue (this file): mtk_wcn_stp_register_if_rx() RX path,
+ *        |                         mtk_wcn_stp_send_data()      TX path
+ *      net/bluetooth (hci0)
+ *        |  BlueZ / RFCOMM
+ *      Xiaomi Smart Band 10 (SPP channel 5) -> collector -> MQTT
+ *
+ * Why not reuse bt_drv_6895.ko (/dev/stpbt) directly?
+ * That driver is a char-device H4 byte pipe for the Android HAL (userspace).
+ * An in-kernel HCI device needs frame delivery to hci_core; instead of
+ * reading/writing its chardev we consume the same STP engine API it uses and
+ * flip the STP core into its built-in "bluez" mode, where complete BT
+ * payloads are pushed directly to a registered in-kernel RX callback
+ * (stp_core.c: stp_process_packet(), "If bluez, direct send packet to
+ * hci_core not through RX buffer!").  No vendor code is modified.
+ *
+ * Data format note: the STP BT payload is the H4 byte stream (HCI packet
+ * type byte included) exactly as the Android HAL reads/writes it on
+ * /dev/stpbt, so the same framing is used here.  In "bluez" mode each
+ * registered-RX callback delivers one complete STP BT payload; a small H4
+ * reassembler is kept for robustness anyway.
+ *
+ * Mutual exclusion: while this driver powers the BT function on, the STP
+ * core routes BT RX away from the /dev/stpbt ring buffer.  Android's
+ * bluetooth HAL must not use /dev/stpbt at the same time (stop/disable it).
+ */
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/slab.h>
+#include <linux/mutex.h>
+#include <linux/skbuff.h>
+#include <asm/unaligned.h>
+
+#include <net/bluetooth/bluetooth.h>
+#include <net/bluetooth/hci_core.h>
+
+#define VERSION "0.1"
+
+/*
+ * wmt_drv.ko is a prebuilt vendor module and is NOT part of this kernel
+ * build, so its symbols must not be referenced at link/modpost time.
+ * Declare the API as weak: modpost sees definitions (no "undefined" errors
+ * and no MODVERSIONS crc entries), and at insmod time the module loader
+ * binds them from the already-loaded wmt_drv.ko; if it is absent they
+ * resolve to NULL.  Every call site null-checks first.
+ *
+ * Signatures are ABI-identical to the vendor headers
+ * (common_main/include/{stp_exp.h,wmt_exp.h} + osal_typedef.h:
+ *  INT32 = int, UINT32 = unsigned int, MTK_WCN_BOOL = int,
+ *  ENUM_WMTDRV_TYPE_T / ENUM_WMTMSG_TYPE_T = int).
+ */
+#define MTK_BT_TASK_INDX	0	/* BT_TASK_INDX     (stp_exp.h)	*/
+#define MTK_WMTDRV_TYPE_BT	0	/* WMTDRV_TYPE_BT   (wmt_exp.h)	*/
+
+/* WMT message types for the whole-chip-reset callback (wmt_exp.h) */
+#define WMTMSG_TYPE_RESET	2
+#define WMTRSTMSG_RESET_START	0
+#define WMTRSTMSG_RESET_END	1
+#define WMTRSTMSG_RESET_END_FAIL 2
+
+extern int  mtk_wcn_stp_send_data(const u8 *buffer, u32 length, u8 type) __weak;
+extern int  mtk_wcn_stp_receive_data(u8 *buffer, u32 length, u8 type) __weak;
+extern int  mtk_wcn_stp_is_rxqueue_empty(u8 type) __weak;
+extern int  mtk_wcn_stp_is_ready(void) __weak;
+extern void mtk_wcn_stp_set_bluez(int flag) __weak;
+extern int  mtk_wcn_stp_register_if_rx(void (*func)(const u8 *data, int size)) __weak;
+extern int  mtk_wcn_wmt_func_on(int type) __weak;
+extern int  mtk_wcn_wmt_func_off(int type) __weak;
+extern int  mtk_wcn_wmt_msgcb_reg(int type,
+			void (*cb)(int src, int dst, int msg_type,
+				   void *buf, u32 sz)) __weak;
+extern int  mtk_wcn_wmt_msgcb_unreg(int type) __weak;
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Alpine on MT6895");
+MODULE_DESCRIPTION("MediaTek STP (wmt_drv) to Linux HCI glue, hci0 without USB");
+MODULE_VERSION(VERSION);
+MODULE_SOFTDEP("pre: wmt_drv");
+
+static bool debug;
+module_param(debug, bool, 0644);
+MODULE_PARM_DESC(debug, "enable verbose logging");
+
+/*
+ * /dev/stpbt uses the same 2048-byte cap (BT_BUFFER_SIZE) between the
+ * Android HAL and the STP engine; keep it as our TX staging limit.
+ */
+#define MTK_TX_BUF_SIZE		2048
+/* RX: one STP BT payload <= STP rx buffer (MTKSTP_BUFFER_SIZE); H4 event
+ * frames top out at 257 bytes, ACL at 1027.  2048 is a comfortable cap.  */
+#define MTK_RX_BUF_SIZE		2048
+
+static struct mtk_stp_hci {
+	struct hci_dev		*hdev;
+	struct sk_buff		*rx_skb;	/* H4 reassembly in progress */
+	int			hdr_need;	/* H4 header bytes still needed */
+	int			dlen;		/* payload len from header, -1 until parsed */
+	struct mutex		lock;		/* guards rx state + tx staging */
+	u8			tx_buf[MTK_TX_BUF_SIZE];
+	bool			bt_on;		/* we own the WMT BT function */
+} mtk;
+
+/* ------------------------------------------------------------------ */
+/* H4 helpers                                                         */
+/* ------------------------------------------------------------------ */
+
+static int h4_header_len(u8 type)
+{
+	switch (type) {
+	case HCI_COMMAND_PKT:	return HCI_COMMAND_HDR_SIZE;	/* 3 */
+	case HCI_ACLDATA_PKT:	return HCI_ACL_HDR_SIZE;	/* 4 */
+	case HCI_SCODATA_PKT:	return HCI_SCO_HDR_SIZE;	/* 3 */
+	case HCI_ISODATA_PKT:	return HCI_ACL_HDR_SIZE;	/* 4 */
+	case HCI_EVENT_PKT:	return HCI_EVENT_HDR_SIZE;	/* 2 */
+	}
+	return 0;
+}
+
+static int h4_payload_len(u8 type, const u8 *hdr)
+{
+	switch (type) {
+	case HCI_COMMAND_PKT:	return hdr[2];			/* plen	*/
+	case HCI_ACLDATA_PKT:	return get_unaligned_le16(hdr + 2); /* dlen */
+	case HCI_ISODATA_PKT:	return get_unaligned_le16(hdr + 2); /* dlen */
+	case HCI_SCODATA_PKT:	return hdr[2];			/* dlen	*/
+	case HCI_EVENT_PKT:	return hdr[1];			/* plen	*/
+	}
+	return 0;
+}
+
+static bool h4_type_valid(u8 type)
+{
+	return type == HCI_COMMAND_PKT || type == HCI_ACLDATA_PKT ||
+	       type == HCI_SCODATA_PKT || type == HCI_EVENT_PKT ||
+	       type == HCI_ISODATA_PKT;
+}
+
+/*
+ * RX callback registered with the STP core.
+ * Context: STP rx kernel thread (sleepable).  @data is a fragment of the
+ * H4 stream; normally one complete HCI packet per call in bluez mode.
+ * Ownership of skbs handed to hci_recv_frame() is transferred (it frees
+ * them on error / when not HCI_UP yet).
+ */
+static void mtk_stp_hci_if_rx(const u8 *data, int size)
+{
+	struct sk_buff *skb;
+
+	mutex_lock(&mtk.lock);
+	while (size > 0) {
+		if (!mtk.rx_skb) {
+			u8 type = *data++;
+
+			size--;
+			if (!h4_type_valid(type)) {
+				bt_dev_warn(mtk.hdev,
+					    "rx resync, drop type 0x%02x",
+					    type);
+				continue;
+			}
+			skb = bt_skb_alloc(MTK_RX_BUF_SIZE, GFP_ATOMIC);
+			if (!skb) {
+				bt_dev_err(mtk.hdev, "rx skb alloc fail");
+				mutex_unlock(&mtk.lock);
+				return;
+			}
+			hci_skb_pkt_type(skb) = type;
+			mtk.rx_skb = skb;
+			mtk.hdr_need = h4_header_len(type);
+			mtk.dlen = -1;
+		}
+
+		skb = mtk.rx_skb;
+
+		if (skb->len < mtk.hdr_need) {
+			int want = min(size, mtk.hdr_need - (int)skb->len);
+
+			memcpy(skb_put(skb, want), data, want);
+			data += want;
+			size -= want;
+			if (skb->len < mtk.hdr_need) {
+				mutex_unlock(&mtk.lock);
+				return;			/* need more header */
+			}
+			mtk.dlen = h4_payload_len(hci_skb_pkt_type(skb),
+						  skb->data);
+			if (mtk.dlen < 0 ||
+			    mtk.dlen > MTK_RX_BUF_SIZE - mtk.hdr_need) {
+				bt_dev_warn(mtk.hdev, "rx bad length %d",
+					    mtk.dlen);
+				kfree_skb(skb);
+				mtk.rx_skb = NULL;
+				continue;
+			}
+		}
+
+		if (mtk.dlen > 0) {
+			int want = min(size, mtk.hdr_need + mtk.dlen -
+				       (int)skb->len);
+
+			memcpy(skb_put(skb, want), data, want);
+			data += want;
+			size -= want;
+		}
+
+		if (skb->len >= mtk.hdr_need + mtk.dlen) {
+			mtk.rx_skb = NULL;
+			/* Still under mtk.lock: hci_recv_frame() only takes
+			 * the rx_q spinlock, and keeping the whole callback
+			 * atomic lets module_exit() drain it safely. */
+			hci_recv_frame(mtk.hdev, skb);
+		} else {
+			mutex_unlock(&mtk.lock);
+			return;				/* need more payload */
+		}
+	}
+	mutex_unlock(&mtk.lock);
+}
+
+/*
+ * Whole chip reset callback from WMT: inject a Hardware Error event so the
+ * stack restarts the controller, mirroring bt_cdev_rst_cb() of stp_chrdev_bt.c.
+ */
+static void mtk_stp_hci_rst_cb(int src, int dst, int msg_type,
+			       void *buf, u32 sz)
+{
+	struct sk_buff *skb;
+	u8 rst_msg;
+
+	if (sz > sizeof(rst_msg))
+		return;
+
+	memcpy(&rst_msg, buf, sz);
+
+	if (msg_type != WMTMSG_TYPE_RESET ||
+	    src != 4 /* WMTDRV_TYPE_WMT */ ||
+	    dst != MTK_WMTDRV_TYPE_BT)
+		return;
+
+	BT_INFO("whole chip reset msg %d", rst_msg);
+
+	if (rst_msg == WMTRSTMSG_RESET_START)
+		return;
+
+	skb = bt_skb_alloc(4, GFP_ATOMIC);
+	if (!skb)
+		return;
+	hci_skb_pkt_type(skb) = HCI_EVENT_PKT;
+	skb_put_u8(skb, HCI_EV_HARDWARE_ERROR);
+	skb_put_u8(skb, 1);	/* parameter length */
+	skb_put_u8(skb, 0x00);	/* hardware code: unspecified failure */
+	hci_recv_frame(mtk.hdev, skb);
+}
+
+/* ------------------------------------------------------------------ */
+/* hci_dev callbacks                                                  */
+/* ------------------------------------------------------------------ */
+
+static int mtk_stp_hci_open(struct hci_dev *hdev)
+{
+	/* All of the wmt_drv API binds (or stays NULL) together at insmod. */
+	if (!mtk_wcn_stp_is_ready || !mtk_wcn_stp_send_data ||
+	    !mtk_wcn_stp_receive_data || !mtk_wcn_stp_is_rxqueue_empty ||
+	    !mtk_wcn_stp_set_bluez || !mtk_wcn_stp_register_if_rx ||
+	    !mtk_wcn_wmt_func_on || !mtk_wcn_wmt_func_off ||
+	    !mtk_wcn_wmt_msgcb_reg || !mtk_wcn_wmt_msgcb_unreg) {
+		bt_dev_err(hdev, "wmt_drv API unavailable (vendor module not loaded)");
+		return -ENODEV;
+	}
+
+	if (!mtk_wcn_stp_is_ready()) {
+		bt_dev_err(hdev, "STP core not ready");
+		return -EIO;
+	}
+
+	if (mtk_wcn_wmt_func_on(MTK_WMTDRV_TYPE_BT) == 0) {
+		bt_dev_err(hdev, "WMT func_on(BT) failed");
+		return -EIO;
+	}
+	mtk.bt_on = true;
+
+	/*
+	 * Switch the STP core BT task into in-kernel bluez mode:
+	 * complete HCI packets go to mtk_stp_hci_if_rx() instead of the
+	 * /dev/stpbt ring buffer.  Register the RX sink first so no packet
+	 * can hit the "sys_if_rx is NULL" window.
+	 */
+	mtk_wcn_stp_register_if_rx(mtk_stp_hci_if_rx);
+	mtk_wcn_stp_set_bluez(1);
+	mtk_wcn_wmt_msgcb_reg(MTK_WMTDRV_TYPE_BT, mtk_stp_hci_rst_cb);
+
+	/* Drain anything stale that might be queued for the chrdev path. */
+	if (debug)
+		while (!mtk_wcn_stp_is_rxqueue_empty(MTK_BT_TASK_INDX)) {
+			u8 tmp[128];
+
+			if (mtk_wcn_stp_receive_data(tmp, sizeof(tmp),
+						     MTK_BT_TASK_INDX) <= 0)
+				break;
+		}
+
+	BT_INFO("BT function on, STP in bluez mode");
+	return 0;
+}
+
+static int mtk_stp_hci_close(struct hci_dev *hdev)
+{
+	if (!mtk_wcn_stp_set_bluez || !mtk_wcn_wmt_msgcb_unreg ||
+	    !mtk_wcn_wmt_func_off)
+		return 0;
+
+	mutex_lock(&mtk.lock);
+	mtk_wcn_wmt_msgcb_unreg(MTK_WMTDRV_TYPE_BT);
+	/* Restore chrdev mode before removing our RX sink. */
+	mtk_wcn_stp_set_bluez(0);
+	mtk_wcn_stp_register_if_rx(NULL);
+	kfree_skb(mtk.rx_skb);
+	mtk.rx_skb = NULL;
+	mutex_unlock(&mtk.lock);
+
+	if (mtk.bt_on) {
+		if (mtk_wcn_wmt_func_off(MTK_WMTDRV_TYPE_BT) == 0)
+			bt_dev_err(hdev, "WMT func_off(BT) failed");
+		mtk.bt_on = false;
+	}
+
+	BT_INFO("BT function off");
+	return 0;
+}
+
+static int mtk_stp_hci_flush(struct hci_dev *hdev)
+{
+	mutex_lock(&mtk.lock);
+	kfree_skb(mtk.rx_skb);
+	mtk.rx_skb = NULL;
+	mutex_unlock(&mtk.lock);
+	return 0;
+}
+
+static int mtk_stp_hci_send(struct hci_dev *hdev, struct sk_buff *skb)
+{
+	u8 type = hci_skb_pkt_type(skb);
+	int len, ret = 0, retry;
+
+	if (!h4_type_valid(type)) {
+		bt_dev_err(hdev, "send, invalid type 0x%02x", type);
+		return -EINVAL;
+	}
+
+	if (!mtk_wcn_stp_send_data) {
+		bt_dev_err(hdev, "send, wmt_drv gone");
+		return -ENODEV;
+	}
+
+	mutex_lock(&mtk.lock);
+
+	/* Re-insert the H4 type byte, exactly what /dev/stpbt writers do. */
+	mtk.tx_buf[0] = type;
+	if (skb->len) {
+		if (skb->len > MTK_TX_BUF_SIZE - 1) {
+			mutex_unlock(&mtk.lock);
+			return -EINVAL;
+		}
+		skb_copy_from_linear_data(skb, mtk.tx_buf + 1, skb->len);
+	}
+	len = skb->len + 1;
+
+	/* STP tx queue can transiently be full; retry like stp_chrdev_bt.c. */
+	for (retry = 0; ; retry++) {
+		ret = mtk_wcn_stp_send_data(mtk.tx_buf, len, MTK_BT_TASK_INDX);
+		if (ret > 0)
+			break;
+		if (ret < 0 || retry >= 3) {
+			hdev->stat.err_tx++;
+			ret = (ret < 0) ? ret : -EAGAIN;
+			mutex_unlock(&mtk.lock);
+			return ret;
+		}
+		msleep(30);
+	}
+
+	hdev->stat.byte_tx += len;
+	mutex_unlock(&mtk.lock);
+
+	/* Core handed us ownership; free on success (hci_send_frame). */
+	kfree_skb(skb);
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* module                                                              */
+/* ------------------------------------------------------------------ */
+
+static int __init mtk_stp_hci_init(void)
+{
+	struct hci_dev *hdev;
+	int err;
+
+	hdev = hci_alloc_dev();
+	if (!hdev)
+		return -ENOMEM;
+
+	mtk.hdev = hdev;
+	mutex_init(&mtk.lock);
+
+	hdev->bus = HCI_VIRTUAL;
+	hdev->dev_type = HCI_PRIMARY;
+	hci_set_drvdata(hdev, &mtk);
+	set_bit(HCI_QUIRK_VALID_LE_STATES, &hdev->quirks);
+
+	hdev->open   = mtk_stp_hci_open;
+	hdev->close  = mtk_stp_hci_close;
+	hdev->flush  = mtk_stp_hci_flush;
+	hdev->send   = mtk_stp_hci_send;
+
+	/* No ->setup(): hci_dev_do_open() runs hci_init_req() on first
+	 * power-on, which issues Read Local Version / Read BD_ADDR etc.
+	 * through this transport - the phase-1 acceptance path. */
+
+	err = hci_register_dev(hdev);
+	if (err < 0) {
+		BT_ERR("hci_register_dev failed %d", err);
+		hci_free_dev(hdev);
+		mtk.hdev = NULL;
+		return err;
+	}
+
+	BT_INFO("registered %s (STP glue) as hci0 candidate", hdev->name);
+	return 0;
+}
+
+static void __exit mtk_stp_hci_exit(void)
+{
+	struct hci_dev *hdev = mtk.hdev;
+
+	if (!hdev)
+		return;
+
+	/* Runs hci_dev_do_close -> close() if UP: set_bluez(0),
+	 * register_if_rx(NULL) and wmt func_off happen there. */
+	hci_unregister_dev(hdev);
+
+	/* Any in-flight mtk_stp_hci_if_rx() holds this lock across the whole
+	 * callback; once acquired, no rx can touch the hdev any more. */
+	mutex_lock(&mtk.lock);
+	mutex_unlock(&mtk.lock);
+
+	hci_free_dev(hdev);
+	mtk.hdev = NULL;
+}
+
+module_init(mtk_stp_hci_init);
+module_exit(mtk_stp_hci_exit);
